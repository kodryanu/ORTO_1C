// Внешняя обработка "Закрытие заказов покупателей" (УНФ 3.0).
// Переводит в состояние "Завершен" заказы покупателей контрагента за период,
// у которых все заказы на производство (связь по ДокументОснование) завершены.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецМесяца(ТекущаяДата());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Найти(Команда)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Сообщить("Не выбран контрагент.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Не заполнен период.");
		Возврат;
	КонецЕсли;
	НайтиЗаказыНаСервере();
	Если Заказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Подходящих заказов покупателей не найдено.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)
	Если Заказы.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных заказов.");
		Возврат;
	КонецЕсли;
	ЗавершитьЗаказыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Строка Из Заказы Цикл
		Строка.Пометка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
	Для Каждого Строка Из Заказы Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя реквизита документа, хранящего состояние/статус заказа.
&НаСервере
Функция ИмяРеквизитаСостояния(ОбъектМетаданных)
	Для Каждого Имя Из СтрРазделить("СостояниеЗаказа,Статус", ",") Цикл
		Если ОбъектМетаданных.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "У документа " + ОбъектМетаданных.Имя + " не найден реквизит состояния (СостояниеЗаказа/Статус).";
КонецФункции

// Возвращает структуру: Имя (реквизит), Завершенные (массив значений "Завершен"),
// Установить (значение для записи в документ).
&НаСервере
Функция ОписаниеСостоянияЗавершен(ИмяДокумента)
	ОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
	Имя = ИмяРеквизитаСостояния(ОбъектМетаданных);
	Реквизит = ОбъектМетаданных.Реквизиты[Имя];
	ТипМД = Метаданные.НайтиПоТипу(Реквизит.Тип.Типы()[0]);

	Завершенные = Новый Массив;
	Если Метаданные.Справочники.Содержит(ТипМД) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ " + ТипМД.ПолноеИмя() + " КАК Т
		|ГДЕ Т.Наименование = ""Завершен"" И НЕ Т.ПометкаУдаления";
		Завершенные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		// Если у справочника состояний есть реквизит Статус (перечисление) — учитываем и его.
		Если ТипМД.Реквизиты.Найти("Статус") <> Неопределено Тогда
			ТипСтатуса = Метаданные.НайтиПоТипу(ТипМД.Реквизиты.Статус.Тип.Типы()[0]);
			Если ТипСтатуса <> Неопределено И Метаданные.Перечисления.Содержит(ТипСтатуса) Тогда
				ЗначениеСтатуса = Неопределено;
				Если ТипСтатуса.ЗначенияПеречисления.Найти("Завершен") <> Неопределено Тогда
					ЗначениеСтатуса = Перечисления[ТипСтатуса.Имя].Завершен;
				КонецЕсли;
				Если ЗначениеСтатуса <> Неопределено Тогда
					Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ " + ТипМД.ПолноеИмя() + " КАК Т
					|ГДЕ Т.Статус = &Статус И НЕ Т.ПометкаУдаления";
					Запрос.УстановитьПараметр("Статус", ЗначениеСтатуса);
					Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
						Если Завершенные.Найти(Строка.Ссылка) = Неопределено Тогда
							Завершенные.Добавить(Строка.Ссылка);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Метаданные.Перечисления.Содержит(ТипМД) Тогда
		Если ТипМД.ЗначенияПеречисления.Найти("Завершен") <> Неопределено Тогда
			Завершенные.Добавить(Перечисления[ТипМД.Имя].Завершен);
		КонецЕсли;
	КонецЕсли;

	Если Завершенные.Количество() = 0 Тогда
		ВызватьИсключение "Не найдено состояние ""Завершен"" для документа " + ИмяДокумента + ".";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Завершенные", Завершенные);
	Результат.Вставить("Установить", Завершенные[0]);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура НайтиЗаказыНаСервере()
	Заказы.Очистить();

	СостояниеЗП = ОписаниеСостоянияЗавершен("ЗаказПокупателя");
	СостояниеЗН = ОписаниеСостоянияЗавершен("ЗаказНаПроизводство");

	// 1. Заказы покупателя за период, не в состоянии "Завершен".
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗП.Ссылка КАК Заказ,
	|	ЗП." + СостояниеЗП.Имя + " КАК Состояние
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗП
	|ГДЕ
	|	ЗП.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ЗП.Контрагент = &Контрагент
	|	И НЕ ЗП.ПометкаУдаления
	|	И НЕ ЗП." + СостояниеЗП.Имя + " В (&Завершенные)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗП.Дата";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Завершенные", СостояниеЗП.Завершенные);
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();
	Если ТаблицаЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// 2. Заказы на производство, созданные на основании этих заказов (ДокументОснование).
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗН.ДокументОснование КАК Заказ,
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР КОГДА ЗН." + СостояниеЗН.Имя + " В (&Завершенные) ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК НеЗавершено
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК ЗН
	|ГДЕ
	|	ЗН.ДокументОснование В (&Заказы)
	|	И НЕ ЗН.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗН.ДокументОснование";
	Запрос.УстановитьПараметр("Заказы", ТаблицаЗаказов.ВыгрузитьКолонку("Заказ"));
	Запрос.УстановитьПараметр("Завершенные", СостояниеЗН.Завершенные);
	ИтогиПроизводства = Запрос.Выполнить().Выгрузить();
	ИтогиПроизводства.Индексы.Добавить("Заказ");

	// 3. Оставляем заказы, у которых все заказы на производство завершены.
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		Итог = ИтогиПроизводства.Найти(СтрокаЗаказа.Заказ, "Заказ");
		Если Итог = Неопределено Тогда
			Если НЕ ВключатьБезЗаказовНаПроизводство Тогда
				Продолжить;
			КонецЕсли;
			Всего = 0;
		Иначе
			Если Итог.НеЗавершено > 0 Тогда
				Продолжить;
			КонецЕсли;
			Всего = Итог.Всего;
		КонецЕсли;

		Новая = Заказы.Добавить();
		Новая.Пометка = Истина;
		Новая.Заказ = СтрокаЗаказа.Заказ;
		Новая.Состояние = Строка(СтрокаЗаказа.Состояние);
		Новая.КоличествоЗаказовНаПроизводство = Всего;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗавершитьЗаказыНаСервере()
	СостояниеЗП = ОписаниеСостоянияЗавершен("ЗаказПокупателя");

	Для Каждого СтрокаЗаказа Из Заказы.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("Документ.ЗаказПокупателя");
			Элемент.УстановитьЗначение("Ссылка", СтрокаЗаказа.Заказ);
			Блокировка.Заблокировать();

			ДокументОбъект = СтрокаЗаказа.Заказ.ПолучитьОбъект();
			ДокументОбъект[СостояниеЗП.Имя] = СостояниеЗП.Установить;
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			ЗафиксироватьТранзакцию();

			СтрокаЗаказа.Состояние = Строка(СостояниеЗП.Установить);
			СтрокаЗаказа.Результат = "Завершен";
			СтрокаЗаказа.Пометка = Ложь;
		Исключение
			ОтменитьТранзакцию();
			СтрокаЗаказа.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
